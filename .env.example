# Copia este fichero a .env y ajusta lo que necesites:
#   cp .env.example .env

# --- Basico ---------------------------------------------------------------
# Carpeta donde viven la base de datos y los documentos.
# Dentro de Docker es /data (montado desde ./data en el host).
MEDICOS_DATA_DIR=/data

# Zona horaria usada para "hoy" y para el calendario.
MEDICOS_ZONA_HORARIA=Europe/Madrid

# --- Acceso desde la red -------------------------------------------------
# En que IP del servidor escucha el contenedor.
#   127.0.0.1  -> solo desde el propio servidor: lo normal con nginx delante
#                 en la misma maquina (ver despliegue/nginx-medicos.conf)
#   0.0.0.0    -> desde cualquier equipo de la red (nginx en otra maquina)
# Ver README, seccion "Instalar en un servidor".
MEDICOS_IP_ESCUCHA=127.0.0.1
MEDICOS_PUERTO=8080

# Carpeta del host donde viven la base de datos y los documentos.
# Por defecto ./data, dentro del propio proyecto.
#MEDICOS_DIR_DATOS=./data

# Nombres e IPs con los que vas a abrir la app, separados por comas. La app
# rechaza cualquier otro (proteccion contra DNS rebinding). localhost y
# 127.0.0.1 van siempre incluidos. Ejemplo:
#   MEDICOS_HOSTS_PERMITIDOS=medicos.tudominio.com
MEDICOS_HOSTS_PERMITIDOS=

# Dias que dura la sesion sin volver a pedir la contrasena (se prolonga con
# el uso, asi que en el movil casi nunca habra que volver a entrar).
MEDICOS_DIAS_SESION=30

# --- Umbrales de aviso ----------------------------------------------------
# Con cuantos dias de antelacion empieza a avisar un requisito previo
# (por ejemplo "analitica 15 dias antes de la cita").
MEDICOS_DIAS_AVISO_REQUISITO=7

# A partir de cuantos dias esperando una llamada se marca como reclamable
# una cita solicitada que sigue sin fecha.
MEDICOS_DIAS_ALERTA_ESPERA=30

# Cuantos dias hacia adelante muestra la pantalla de inicio.
MEDICOS_DIAS_HORIZONTE=14

# --- IA: lectura de documentos y de lo apuntado de una llamada ------------
# Proveedor: claude-cli | anthropic | openai | gemini | ollama | ninguno
# Cual elegir, que cuesta cada uno y que sale de tu red: docs/PROVEEDORES-IA.md
# "claude-cli" usa el binario `claude` ya autenticado en la maquina y no
# necesita ninguna API key: consume tu suscripcion de Claude.
MEDICOS_IA_PROVEEDOR=claude-cli

# Modelo, si no quieres el de por defecto de cada proveedor.
# MEDICOS_IA_MODELO=

# --- claude-cli: token de tu suscripcion de Claude.
# Generalo en cualquier ordenador con Claude Code instalado:
#     claude setup-token
# y pegalo aqui. Es una credencial: el .env nunca va al repositorio.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- anthropic: la misma Claude, pero pagando por uso.
# ANTHROPIC_API_KEY=sk-ant-...
# MEDICOS_IA_MODELO=claude-sonnet-5

# --- openai (GPT). Los PDF se mandan como paginas dibujadas.
# OPENAI_API_KEY=sk-...
# MEDICOS_IA_MODELO=gpt-4o

# --- gemini (Google). Tiene plan gratuito con limites y lee PDF.
# GEMINI_API_KEY=...
# MEDICOS_IA_MODELO=gemini-2.5-flash

# --- ollama: en tu propia maquina, no sale nada de tu red.
# Necesita un modelo con vision ya descargado (ollama pull llama3.2-vision).
# MEDICOS_OLLAMA_URL=http://localhost:11434
# MEDICOS_IA_MODELO=llama3.2-vision
